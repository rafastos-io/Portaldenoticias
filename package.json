{
  "name": "broadcast-saude-longevidade",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/reset-demo.mjs",
    "smoke:admin": "node --env-file-if-exists=.env.local scripts/smoke-admin.mjs",
    "smoke:a11y": "node scripts/smoke-accessibility.mjs",
    "release:promote": "node --env-file-if-exists=.env.local scripts/promote-with-smoke.mjs",
    "build": "next build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "playwright": "1.62.0",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
