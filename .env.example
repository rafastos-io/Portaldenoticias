# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gate demonstrativo do ADM - não é autenticação de produção
DEMO_ADMIN_USER=USER
DEMO_ADMIN_PASSWORD=User123
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase - servidor apenas; use uma chave moderna sb_secret_
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=replace-with-modern-server-secret
DATABASE_URL=postgresql://postgres.your-project-id:your-password@your-pooler-host:6543/postgres
SUPABASE_STORAGE_BUCKET=demo-media

# Reset explícito do catálogo demo; nunca habilitar em Production
DEMO_ENVIRONMENT=development
DEMO_RESET_CONFIRMATION=disabled

# Smoke publicado (tokens de Preview devem ficar somente no ambiente)
SMOKE_BASE_URL=http://localhost:3000
SMOKE_ENVIRONMENT=local
SMOKE_ADMIN_USER=USER
SMOKE_ADMIN_PASSWORD=User123
SMOKE_BROWSER_CHANNEL=chrome
SMOKE_ARTIFACTS_DIR=artifacts/smoke-admin
